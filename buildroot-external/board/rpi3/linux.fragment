# RustNAS additions on top of the Raspberry Pi kernel defconfig

# In-kernel SMB3 server (ksmbd): far lighter than Samba
CONFIG_SMB_SERVER=m
# CONFIG_SMB_SERVER_SMBDIRECT is not set

# USB disks (incl. UAS enclosures) and their filesystems
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=m
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Compressed swap in RAM
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=m
CONFIG_CRYPTO_LZ4=y
CONFIG_ZRAM_BACKEND_LZ4=y

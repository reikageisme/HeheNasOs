# RustNAS SD card layout (A/B)
#   p1  boot     FAT32   firmware, Image-a/b, cmdline-a/b.txt, slot.txt
#   p2  rootfs-a ext4    read-only system, slot A
#   p3  rootfs-b ext4    read-only system, slot B (updates go to the idle slot)
#   p4  persist  ext4    /var/lib/rustnas (accounts, shares, network, TLS...)

image boot.vfat {
	vfat {
		files = {
#BOOT_FILES#
		}
	}
	size = 64M
}

image rustnas-rpi3b-aarch64.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs-a {
		partition-type = 0x83
		image = "rootfs.ext4"
	}

	partition rootfs-b {
		partition-type = 0x83
		image = "rootfs.ext4"
	}

	partition persist {
		partition-type = 0x83
		image = "persist.ext4"
	}
}

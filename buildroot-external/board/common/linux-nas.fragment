# HeheNAS kernel options (all boards)

# In-kernel SMB3 server (ksmbd): far lighter than Samba
CONFIG_SMB_SERVER=m
# CONFIG_SMB_SERVER_SMBDIRECT is not set

# NFS server (started only when enabled in the UI)
CONFIG_NFSD=m
CONFIG_NFSD_V3=y
CONFIG_NFSD_V4=y

# Firewall (nftables)
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m

# USB disks (incl. UAS enclosures) and their filesystems
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=m
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Compressed swap in RAM
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=m
CONFIG_CRYPTO_LZ4=y
CONFIG_ZRAM_BACKEND_LZ4=y

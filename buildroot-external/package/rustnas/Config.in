config BR2_PACKAGE_RUSTNAS
	bool "rustnas"
	help
	  RustNAS management daemon (rustnasd) with its embedded web
	  dashboard, plus the init script for the ksmbd SMB server.

	  rustnasd is cross-compiled outside Buildroot as a fully static
	  <arch>-unknown-linux-musl binary (scripts/build-core.sh).

if BR2_PACKAGE_RUSTNAS

config BR2_PACKAGE_RUSTNAS_BOARD
	string "board id"
	default "x86_64" if BR2_x86_64
	default "rpi3b"
	help
	  Selects files/rustnasd-<board>.toml and is checked against
	  update bundles.

endif

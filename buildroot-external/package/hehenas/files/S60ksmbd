#!/bin/sh
#
# ksmbd: in-kernel SMB3 server. ksmbd.mountd is its small user-space helper.
# The config is generated by hehenasd (/etc/ksmbd -> /var/lib/hehenas/ksmbd).
#

STATE=/var/lib/hehenas/ksmbd
CONF="$STATE/ksmbd.conf"

start() {
	mkdir -p "$STATE"
	modprobe ksmbd 2>/dev/null
	if [ ! -s "$CONF" ]; then
		echo "ksmbd: no config yet (hehenasd will create it)"
		return 0
	fi
	if pidof ksmbd.mountd >/dev/null; then
		return 0
	fi
	printf "Starting ksmbd: "
	if ksmbd.mountd; then echo "OK"; else echo "FAIL"; return 1; fi
}

stop() {
	printf "Stopping ksmbd: "
	ksmbd.control -s >/dev/null 2>&1 || killall ksmbd.mountd 2>/dev/null
	echo "OK"
}

reload() {
	if pidof ksmbd.mountd >/dev/null; then
		ksmbd.control -r >/dev/null 2>&1 || killall -HUP ksmbd.mountd
	else
		start
	fi
}

case "$1" in
	start|stop|reload)
		"$1";;
	restart)
		stop; sleep 1; start;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1;;
esac

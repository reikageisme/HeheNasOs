# RustNAS: merged on top of Buildroot's raspberrypi3_64_defconfig by
# scripts/build-image.sh (keeps the kernel/firmware versions Buildroot pins).

# --- toolchain: prebuilt Bootlin aarch64 musl (skips building GCC: ~1 h less) ---
# BR2_TOOLCHAIN_BUILDROOT is not set
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_MUSL_STABLE=y

# --- system ---
BR2_TARGET_GENERIC_HOSTNAME="rustnas"
BR2_TARGET_GENERIC_ISSUE="RustNAS OS"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RUSTNAS_PATH)/board/rpi3/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RUSTNAS_PATH)/board/rpi3/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RUSTNAS_PATH)/board/rpi3/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS=""

# --- kernel: Buildroot's Raspberry Pi kernel + NAS options ---
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RUSTNAS_PATH)/board/rpi3/linux.fragment"

# --- firmware: cut-down GPU firmware so gpu_mem=16 frees ~60 MB of RAM ---
BR2_PACKAGE_RPI_FIRMWARE_CD=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_RUSTNAS_PATH)/board/rpi3/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_RUSTNAS_PATH)/board/rpi3/cmdline.txt"

# --- filesystems ---
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_FSCK=y

# --- NAS services ---
BR2_PACKAGE_KSMBD_TOOLS=y
BR2_PACKAGE_RUSTNAS=y

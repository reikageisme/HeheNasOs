# HeheNAS live ISO for x86_64 PCs: merged on top of Buildroot's
# pc_x86_64_bios_defconfig by scripts/build-image.sh (BOARD=x86_64).
# Boots from USB/CD into RAM; settings persist on a partition labelled
# "hehenas-data" if one exists.

# BR2_TOOLCHAIN_BUILDROOT is not set
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_MUSL_STABLE=y

BR2_TARGET_GENERIC_HOSTNAME="hehenas"
BR2_TARGET_GENERIC_ISSUE="HeheNAS OS"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_HEHENAS_PATH)/board/common/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_HEHENAS_PATH)/board/common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT=""
BR2_ROOTFS_POST_SCRIPT_ARGS="x86"

BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_HEHENAS_PATH)/board/common/linux-nas.fragment $(BR2_EXTERNAL_HEHENAS_PATH)/board/x86_64/linux.fragment"

# Live ISO: rootfs as gzip'd initramfs, isolinux, hybrid (dd to USB works)
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_ISOLINUX=y
BR2_TARGET_ROOTFS_ISO9660_INITRD=y
BR2_TARGET_ROOTFS_ISO9660_HYBRID=y
BR2_TARGET_SYSLINUX=y
BR2_TARGET_SYSLINUX_ISOLINUX=y
# BR2_TARGET_ROOTFS_EXT2 is not set

BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_FSCK=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_FDISKS=y
BR2_PACKAGE_UTIL_LINUX_WIPEFS=y
BR2_PACKAGE_SMARTMONTOOLS=y
BR2_PACKAGE_KSMBD_TOOLS=y
BR2_PACKAGE_NFS_UTILS=y
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_HEHENAS=y

# BusyBox extras: ntpd (no RTC on the Pi), blkid with filesystem types
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_HEHENAS_PATH)/board/common/busybox.fragment"

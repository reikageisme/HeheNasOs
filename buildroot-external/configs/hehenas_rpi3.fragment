# HeheNAS for Raspberry Pi 3B: merged on top of Buildroot's
# raspberrypi3_64_defconfig by scripts/build-image.sh.

# --- toolchain: prebuilt Bootlin aarch64 musl (skips building GCC) ---
# BR2_TOOLCHAIN_BUILDROOT is not set
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_MUSL_STABLE=y

# --- system: read-only rootfs, state on the persist partition ---
BR2_TARGET_GENERIC_HOSTNAME="hehenas"
BR2_TARGET_GENERIC_ISSUE="HeheNAS OS"
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_HEHENAS_PATH)/board/common/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_HEHENAS_PATH)/board/common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_HEHENAS_PATH)/board/rpi3/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="rpi3"

# --- kernel ---
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_HEHENAS_PATH)/board/common/linux-nas.fragment"

# --- firmware: cut-down GPU firmware so gpu_mem=16 frees ~60 MB of RAM ---
BR2_PACKAGE_RPI_FIRMWARE_CD=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_HEHENAS_PATH)/board/rpi3/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_HEHENAS_PATH)/board/rpi3/cmdline.txt"

# --- filesystems ---
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
BR2_PACKAGE_HOST_E2FSPROGS=y

# --- NAS packages ---
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_FSCK=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_FDISKS=y
BR2_PACKAGE_UTIL_LINUX_WIPEFS=y
BR2_PACKAGE_SMARTMONTOOLS=y
BR2_PACKAGE_KSMBD_TOOLS=y
BR2_PACKAGE_NFS_UTILS=y
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_HEHENAS=y

# BusyBox extras: ntpd (no RTC on the Pi), blkid with filesystem types
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_HEHENAS_PATH)/board/common/busybox.fragment"
